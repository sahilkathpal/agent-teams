# Site
SITE_DOMAIN=codeongrass.com

# Otterly citation tracking
OTTERLY_EXPORTS_DIR=./data/otterly-exports
MAX_TRACKED_PROMPTS=15

# Ghost blog (publishing + blog index)
GHOST_URL=
GHOST_ADMIN_KEY=
GHOST_CONTENT_KEY=

# Syndication
DEVTO_API_KEY=
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# Research sources
PARALLEL_API_KEY=
GITHUB_TOKEN=

# Database (optional — defaults to ./data/measurement.db)
# MEASUREMENT_DB_PATH=./data/measurement.db

# Static files directory for llms.txt (defaults to /var/www/codeongrass-static)
# LLMS_TXT_DIR=/var/www/codeongrass-static

# Webhook server (for Ghost → syndication queue)
GHOST_WEBHOOK_SECRET=
WEBHOOK_PORT=3847

# Email notifications (optional — uses Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM=proposals@updates.codeongrass.com
